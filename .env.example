# ─────────────────────────────────────────────────────────────────────
# Environment variables. Set them in Vercel → Project → Settings →
# Environment Variables (and locally in .env.development). Never commit
# real values. Everything is optional for the preview deploy.
# ─────────────────────────────────────────────────────────────────────

# Search engines. Leave unset (or anything but "true") until launch —
# the site then sends noindex everywhere and robots.txt blocks all crawlers.
# Changing it needs a redeploy.
ALLOW_INDEXING=

# ── Backend (Payload CMS + Neon). Leave DATABASE_URI unset for preview
# mode: the site shows the built-in launch articles and /admin is closed.
# Neon → Connection details → "Pooled connection" string.
DATABASE_URI=
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# ── Uploaded images → Cloudflare R2 (S3-compatible API, free 10 GB)
# R2 → Manage API tokens → Create token (Object Read & Write on the bucket).
R2_BUCKET=rightium-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public address of the bucket (custom domain such as https://media.rightium.in,
# or the bucket's r2.dev URL while testing).
R2_PUBLIC_URL=

# ── Email via Resend (free: 3,000/month, 100/day). Each enquiry sends 2
# emails: a notification to you and an acknowledgement to the client.
RESEND_API_KEY=
CONTACT_TO=contact@rightium.in
CONTACT_FROM="Rightium <noreply@rightium.in>"

# ── Cloudflare Turnstile bot check on the contact form (free).
# Set BOTH or NEITHER — a secret without the site key blocks every submission.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── PostHog analytics (free: 1M events/month). Leave the key empty to disable.
NEXT_PUBLIC_POSTHOG_KEY=
# US project: https://us.i.posthog.com + https://us.posthog.com
# EU project: https://eu.i.posthog.com + https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
